FROM python:3.12-slim

WORKDIR /app

# Variáveis de ambiente
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONIOENCODING=utf-8

# Instalar APENAS o unzip para extração rápida
RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Copiar requisitos de setup
COPY requirements-setup.txt .

# Instalar dependências leves
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements-setup.txt && \
    rm -rf /root/.cache/pip

# Copiar o código (ignorado pelo .dockerignore)
COPY . .

# Comando padrão
CMD ["python", "-m", "scripts.prepare_data"]
